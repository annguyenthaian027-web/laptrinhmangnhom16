# Sao chép file này thành .env rồi sửa giá trị:  cp .env.example .env
# KHÔNG commit file .env lên GitHub (đã có trong .gitignore).

# ---- Chung ----
TZ=Asia/Ho_Chi_Minh

# ---- Pi-hole (TV1) ----
# Mật khẩu đăng nhập trang quản trị Pi-hole, backend cũng dùng mật khẩu này để gọi API
PIHOLE_PASSWORD=doi-mat-khau-nay
# Nên ghim phiên bản cụ thể khi đã chạy ổn (ví dụ 2025.11.1) thay vì latest
PIHOLE_TAG=latest
# Đổi cổng nếu máy đã có dịch vụ dùng cổng 80/443 (ví dụ 8081, 8443)
PIHOLE_WEB_PORT=80
PIHOLE_WEB_HTTPS_PORT=443

# ---- Backend (TV2) ----
# Địa chỉ Pi-hole bên trong mạng Docker đã được đặt sẵn trong docker-compose.yml
BACKEND_PORT=8080

# ---- Frontend (TV3) ----
FRONTEND_PORT=3000

# ---- WireGuard VPN (TV1, chỉ cần khi dùng --profile vpn) ----
# IP công khai hoặc tên miền của máy chạy hệ thống
WG_HOST=your.public.ip.or.domain
# Mật khẩu trang quản lý WireGuard, đã băm bcrypt (xem README phần VPN để tạo)
WG_PASSWORD_HASH=
WG_PORT=51820
WG_UI_PORT=51821
