server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Khóa mật khẩu (nếu đặt BASIC_AUTH_PASS); file này do 25-auth.sh tạo khi container khởi động
    include /etc/nginx/auth.conf;

    # Frontend chỉ gọi /api; nginx chuyển tiếp sang backend (BACKEND_URL)
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
    }
}
